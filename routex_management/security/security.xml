<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_routex" model="ir.module.category">
        <field name="name">RouteX</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_route_user" model="res.groups">
        <field name="name">Route User</field>
        <field name="category_id" ref="module_category_routex"/>
    </record>

    <record id="group_route_team_leader" model="res.groups">
        <field name="name">Route Team Leader</field>
        <field name="category_id" ref="module_category_routex"/>
        <field name="implied_ids" eval="[(4, ref('group_route_user'))]"/>
    </record>

    <record id="group_route_manager" model="res.groups">
        <field name="name">Route Manager</field>
        <field name="category_id" ref="module_category_routex"/>
        <field name="implied_ids" eval="[(4, ref('group_route_team_leader'))]"/>
    </record>

    <record id="rule_plan_user" model="ir.rule">
        <field name="name">Route plans - own salesperson</field>
        <field name="model_id" ref="model_routex_route_plan"/>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
        <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
    </record>
    <record id="rule_plan_manager" model="ir.rule">
        <field name="name">Route plans - manager all</field>
        <field name="model_id" ref="model_routex_route_plan"/>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_line_user" model="ir.rule">
        <field name="name">Route visits - own salesperson</field>
        <field name="model_id" ref="model_routex_route_plan_line"/>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
        <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
    </record>
    <record id="rule_line_leader" model="ir.rule">
        <field name="name">Route visits - assigned team leader</field>
        <field name="model_id" ref="model_routex_route_plan_line"/>
        <field name="groups" eval="[(4, ref('group_route_team_leader'))]"/>
        <field name="domain_force">['|', ('salesperson_id', '=', user.id), ('team_leader_id', '=', user.id)]</field>
    </record>
    <record id="rule_line_manager" model="ir.rule">
        <field name="name">Route visits - manager all</field>
        <field name="model_id" ref="model_routex_route_plan_line"/>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_template_user" model="ir.rule">
        <field name="name">Templates - own salesperson</field>
        <field name="model_id" ref="model_routex_route_plan_template"/>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
        <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
    </record>
    <record id="rule_template_manager" model="ir.rule">
        <field name="name">Templates - manager all</field>
        <field name="model_id" ref="model_routex_route_plan_template"/>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_route_user" model="ir.rule">
        <field name="name">Routes - users</field>
        <field name="model_id" ref="model_routex_route"/>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
        <field name="domain_force">[('active', '=', True)]</field>
    </record>
    <record id="rule_route_manager" model="ir.rule">
        <field name="name">Routes - manager all</field>
        <field name="model_id" ref="model_routex_route"/>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_area_user" model="ir.rule">
        <field name="name">Route areas - users</field>
        <field name="model_id" ref="model_routex_route_area"/>
        <field name="groups" eval="[(4, ref('group_route_user'))]"/>
        <field name="domain_force">[('active', '=', True)]</field>
    </record>
    <record id="rule_area_manager" model="ir.rule">
        <field name="name">Route areas - manager all</field>
        <field name="model_id" ref="model_routex_route_area"/>
        <field name="groups" eval="[(4, ref('group_route_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
