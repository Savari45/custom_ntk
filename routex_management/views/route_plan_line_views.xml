<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plan_line_list" model="ir.ui.view">
        <field name="name">routex.route.plan.line.list</field>
        <field name="model">routex.route.plan.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="salesperson_id"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"/>
                <field name="start_on"/>
                <field name="end_on"/>
                <field name="total_time"/>
                <field name="cancellation_reason_id"/>
                                    <field name="cancellation_reason"/>
            </list>
        </field>
    </record>

    <record id="view_plan_line_form" model="ir.ui.view">
        <field name="name">routex.route.plan.line.form</field>
        <field name="model">routex.route.plan.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_skip" type="object" string="Skip"
                            invisible="state not in ['planned', 'in_progress']"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            invisible="state != 'completed'"
                            groups="routex_management.group_route_team_leader,routex_management.group_route_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'completed'"
                            groups="routex_management.group_route_team_leader,routex_management.group_route_manager"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state not in ['approved', 'rejected', 'skipped']"
                            groups="routex_management.group_route_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,in_progress,completed,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="partner_id"/>
                            <field name="salesperson_id"/>
                            <field name="team_leader_id"/>
                            <field name="scheduled_date"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="planned_minutes"/>
                            <field name="start_on"/>
                            <field name="end_on"/>
                            <field name="total_time"/>
                            <field name="payment_collected"/>
                        </group>
                    </group>
                    <group string="GPS">
                        <field name="latitude"/>
                        <field name="longitude"/>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="visit_notes"/>
                        <field name="cancellation_reason_id"/>
                                    <field name="cancellation_reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_plan_line_search" model="ir.ui.view">
        <field name="name">routex.route.plan.line.search</field>
        <field name="model">routex.route.plan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="salesperson_id"/>
                <field name="team_leader_id"/>
                <field name="state"/>
                <field name="scheduled_date"/>
                <filter name="approval" string="To Approve"
                        domain="[('state', '=', 'completed')]"/>
                <filter name="my_visits" string="My Visits"
                        domain="[('salesperson_id', '=', uid)]"/>
                <group string="Group By">
                    <filter name="plan" string="Route Plan"
                            context="{'group_by': 'plan_id'}"/>
                    <filter name="customer" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="date" string="Date"
                            context="{'group_by': 'scheduled_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_plan_line" model="ir.actions.act_window">
        <field name="name">Customer Visits</field>
        <field name="res_model">routex.route.plan.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_plan_line_search"/>
    </record>

    <record id="action_plan_approval" model="ir.actions.act_window">
        <field name="name">Visits To Approve</field>
        <field name="res_model">routex.route.plan.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'completed')]</field>
        <field name="search_view_id" ref="view_plan_line_search"/>
    </record>
</odoo>
