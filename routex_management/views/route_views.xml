<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_route_list" model="ir.ui.view">
        <field name="name">routex.route.list</field>
        <field name="model">routex.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="area_id"/>
                <field name="salesperson_id"/>
                <field name="sales_team"/>
                <field name="customer_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_route_form" model="ir.ui.view">
        <field name="name">routex.route.form</field>
        <field name="model">routex.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="area_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="sales_team"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customers">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="description"/>
                                    <field name="planned_minutes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">routex.route</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
