<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_plan_list" model="ir.ui.view">
        <field name="name">routex.route.plan.list</field>
        <field name="model">routex.route.plan</field>
        <field name="arch" type="xml">
            <list>
                <!--                <field name="name"/>-->
                <field name="scheduled_date"/>
                <field name="salesperson_id"/>
                <field name="vehicle_id"/>
                <!--                <field name="driver_id"/>-->
                <!--                <field name="helper_id"/>-->
                <!--                <field name="route_ids" widget="many2many_tags"/>-->
                <field name="state"
                       widget="badge"
                       string="Trip Status"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'planned'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'complete'"
                       decoration-danger="state == 'cancelled'"/>
                <!--                <field name="customer_count"/>-->
                <!--                <field name="completed_count"/>-->
                <!--                <field name="pending_approval_count"/>-->
                <!--                <field name="approved_count"/>-->
            </list>
        </field>
    </record>

    <record id="view_plan_form" model="ir.ui.view">
        <field name="name">routex.route.plan.form</field>
        <field name="model">routex.route.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_plan" type="object" string="Plan"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_close" type="object" string="End"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset To Draft"
                            invisible="state == 'draft'"
                            groups="routex_management.group_route_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ['closed', 'cancelled']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Sale Orders -->
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="sale_order_count" widget="statinfo" string="Sale Orders"/>      </button>
                        <!-- Invoices -->
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>

                        <!-- Collections -->
                        <button name="action_view_collections" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="collection_count" widget="statinfo" string="Collections"/>
                        </button>

                        <!-- Deliveries -->
                        <button name="action_view_deliveries" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="delivery_count"
                                   widget="statinfo"
                                   string="Deliveries"/>
                        </button>

                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="INFO">
                            <field name="salesperson_id"/>
                            <!--                            <field name="team_leader_id"/>-->
                            <!--                            <field name="sales_team"/>-->
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="helper_id"/>
                            <field name="scheduled_date"/>
                            <field name="route_ids" widget="many2many_tags"/>
                        </group>
                        <group string="PAYMENT COLLECTION">
                            <field name="cash_amount"/>
                            <field name="cheque_amount"/>
                            <field name="bank_transfer_amount"/>
                        </group>
                    </group>

                    <group>
                        <group string="ODOMETER READING START">
                            <field name="meter_reading_start"/>
                            <field name="start_image" widget="image"/>
                        </group>
                        <group string="ODOMETER READING END">
                            <field name="meter_reading_end"/>
                            <field name="end_image" widget="image"/>
                        </group>
                    </group>

                    <group>
                        <field name="customer_count" readonly="1"/>
                        <field name="planned_count" readonly="1"/>
                        <field name="in_progress_count" readonly="1"/>
                        <field name="completed_count" readonly="1"/>
                        <field name="skipped_count" readonly="1"/>
                        <field name="pending_approval_count" readonly="1"/>
                        <field name="approved_count" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Routes">
                            <field name="line_ids" readonly="state == 'closed'">
                                <list>
                                    <field name="sequence"/>
                                    <field name="partner_id"/>
                                    <field name="description"/>
                                    <field name="state" widget="badge"/>
                                    <field name="start_on"/>
                                    <field name="end_on"/>
                                    <field name="total_time"/>
                                    <field name="cancellation_reason_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_plan_search" model="ir.ui.view">
        <field name="name">routex.route.plan.search</field>
        <field name="model">routex.route.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="salesperson_id"/>
                <field name="team_leader_id"/>
                <field name="route_ids"/>
                <field name="scheduled_date"/>
                <field name="state"/>
                <filter name="my" string="My Routes"
                        domain="[('salesperson_id', '=', uid)]"/>
                <group string="Group By">
                    <filter name="route" string="Route"
                            context="{'group_by': 'route_ids'}"/>
                    <filter name="salesperson" string="Sales Person"
                            context="{'group_by': 'salesperson_id'}"/>
                    <filter name="date" string="Date"
                            context="{'group_by': 'scheduled_date'}"/>
                    <filter name="state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_plan" model="ir.actions.act_window">
        <field name="name">Route Plans</field>
        <field name="res_model">routex.route.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_plan_search"/>
    </record>
</odoo>
