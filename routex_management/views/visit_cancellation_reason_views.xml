<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visit_cancellation_reason_list" model="ir.ui.view">
        <field name="name">routex.visit.cancellation.reason.list</field>
        <field name="model">routex.visit.cancellation.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_visit_cancellation_reason_form" model="ir.ui.view">
        <field name="name">routex.visit.cancellation.reason.form</field>
        <field name="model">routex.visit.cancellation.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_visit_cancellation_reason" model="ir.actions.act_window">
        <field name="name">Visit Cancellation Reasons</field>
        <field name="res_model">routex.visit.cancellation.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
