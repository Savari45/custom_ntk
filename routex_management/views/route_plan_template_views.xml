<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_template_list" model="ir.ui.view">
        <field name="name">routex.route.plan.template.list</field>
        <field name="model">routex.route.plan.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="salesperson_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id" optional="show"/>
                <field name="helper_id" optional="show"/>
                <field name="route_ids" widget="many2many_tags" optional="show"/>
                <field name="execute_every" optional="show"/>
                <field name="interval_type" optional="show"/>
                <field name="next_execution_date" optional="show"/>
                <!--                <field name="active"/>-->
            </list>
        </field>
    </record>

    <record id="view_template_form" model="ir.ui.view">
        <field name="name">routex.route.plan.template.form</field>
        <field name="model">routex.route.plan.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Status -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                    <!-- Draft -->
                    <button name="action_draft" type="object" string="Set to Draft" invisible="state == 'draft'" class="btn-secondary"/>
                    <!-- Confirm -->
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="btn-primary"/>
                    <!-- Plan -->
                    <button name="action_plan" type="object" string="Plan" invisible="state != 'confirmed'" class="btn-primary"/>
                    <!-- Cancel -->
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Route Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="salesperson_id"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="helper_id"/>
                            <field name="route_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="execute_every"/>
                            <field name="interval_type"/>
                            <field name="next_execution_date"/>
                            <field name="last_execution_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Routes">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <!--                                    <field name="sequence" widget="handle"/>-->
                                    <field name="partner_id"/>
                                    <field name="description"/>
                                    <!--                                    <field name="planned_minutes"/>-->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_template" model="ir.actions.act_window">
        <field name="name">Route Plan Templates</field>
        <field name="res_model">routex.route.plan.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
