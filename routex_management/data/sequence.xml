<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_route" model="ir.sequence">
        <field name="name">Route</field>
        <field name="code">routex.route</field>
        <field name="prefix">RT/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_route_plan" model="ir.sequence">
        <field name="name">Route Plan</field>
        <field name="code">routex.route.plan</field>
        <field name="prefix">RPLAN/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>
